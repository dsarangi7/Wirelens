<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS settings for Wirelens: serve the 3D model and rack data, no caching of the page. -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".glb" />
      <mimeMap fileExtension=".glb" mimeType="model/gltf-binary" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
